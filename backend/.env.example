APP_NAME="St George Hospital Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Australia/Sydney
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgh_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@stgeorgehospital.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sandbox / mock external service credentials (SRS 2.4, 4.3.3) ---
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_SID=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_FROM=

# Payment gateway (FR40) — sandbox by default, no credentials required.
# To exercise real Stripe TEST-mode (never live), set PROVIDER=stripe, then:
#   KEY        = Stripe secret key     sk_test_...  (Dashboard > Developers > API keys)
#   PUBLISHABLE= Stripe publishable key pk_test_... (same page; safe for the browser)
#   SECRET     = Stripe webhook secret  whsec_...  (optional, unused by sync flow)
# Test card to try it: 4242 4242 4242 4242, any future expiry, any CVV.
PAYMENT_GATEWAY_PROVIDER=sandbox
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_PUBLISHABLE=
PAYMENT_GATEWAY_CURRENCY=aud

# AI provider (FR46 chatbot) — OpenRouter gateway. Leave AI_API_KEY empty to
# run the assistant in its "not configured" fallback mode.
AI_PROVIDER=openrouter
AI_API_KEY=
# Model to answer with. Must be one that actually responds quickly — the very
# large free models sit in OpenRouter's queue and time out.
AI_MODEL=inclusionai/ling-3.0-flash-sante:free
# Provider timeout in seconds. MUST stay below PHP's max_execution_time, or a
# slow provider fatals the request (500) instead of returning the fallback.
AI_TIMEOUT_SECONDS=25
